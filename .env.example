##############################################################################
# InkFlow AI — Backend environment
#
# Copy to `.env` and fill in the values:  cp .env.example .env
# Variables marked REQUIRED must be set or the server refuses to boot.
##############################################################################

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info                      # debug | info | warn | error | silent

# ---------------------------------------------------------------------------
# Database — REQUIRED
#
# Local:  mongodb://127.0.0.1:27017/inkflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inkflow?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/inkflow

# ---------------------------------------------------------------------------
# JWT — REQUIRED (minimum 32 characters each, and they MUST differ)
#
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt cost factor. 12 is a sensible production default; lower only for tests.
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Client & CORS
#
# CLIENT_URL is the frontend origin; it is always allowed and is used to build
# the links inside verification and password-reset emails.
# CORS_ORIGINS adds further comma-separated origins (staging, preview builds).
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Cookies
#
# Same-site deployment (frontend and API share a domain): lax + secure in prod.
# Cross-site deployment (Vercel frontend, Render API): COOKIE_SAME_SITE=none,
# which browsers only honour together with COOKIE_SECURE=true over HTTPS.
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300                  # per window, all API routes
AUTH_RATE_LIMIT_MAX=20              # per window, login/register/reset

# ---------------------------------------------------------------------------
# Email (SMTP)
#
# Optional. Leave blank in development: emails are logged to the console
# instead of sent, so verification and reset links remain usable.
#
# Gmail requires an App Password, not your account password.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                   # true only for port 465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=InkFlow AI
MAIL_FROM_ADDRESS=no-reply@inkflow.ai

EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# AI Assistant (optional)
#
# Set GROQ_API_KEY to a server-side secret from Groq Cloud.
# Never expose this in a VITE_ variable or frontend code.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# OAuth (optional)
#
# Each provider stays disabled until both its id and secret are present;
# GET /api/v1/oauth/providers reports which are live, so the UI can hide
# buttons that would not work.
#
# Google:  https://console.cloud.google.com/apis/credentials
# GitHub:  https://github.com/settings/developers
#
# Register the callback URL below with the provider exactly as written.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/oauth/github/callback

# ---------------------------------------------------------------------------
# Uploads
#
# Note: disk storage does not survive a redeploy on ephemeral hosts such as
# Heroku or Render's free tier. Point UPLOAD_DIR at a mounted volume, or swap
# the storage engine in src/middlewares/upload.middleware.js for S3/Cloudinary.
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
SERVE_UPLOADS=true

# ---------------------------------------------------------------------------
# Background jobs
#
# Set to false on additional instances so scheduled jobs run on exactly one.
# ---------------------------------------------------------------------------
ENABLE_CRON=true

# ---------------------------------------------------------------------------
# Payments — Safepay
#
# Billing stays off until all four credentials below are set. With any one
# missing, POST /api/v1/billing/checkout answers 503 PAYMENT_NOT_CONFIGURED,
# the webhook answers 503, and no route can grant a paid plan.
#
# Sandbox dashboard:  https://sandbox.api.getsafepay.com/dashboard
# Live dashboard:     https://getsafepay.com/dashboard
#
# None of these ever reach the browser: the checkout endpoint returns a URL
# and nothing else.
#
#   SAFEPAY_ENVIRONMENT     sandbox | production | development
#   SAFEPAY_API_KEY         "sec_…", from Developers > API Keys
#   SAFEPAY_V1_SECRET       merchant secret, sent as X-SFPY-MERCHANT-SECRET on
#                           server-to-server calls
#   SAFEPAY_WEBHOOK_SECRET  shared secret behind the HMAC-SHA512 signature,
#                           shown against the endpoint in Developers >
#                           Endpoints. Sandbox and live have different ones.
# ---------------------------------------------------------------------------
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_V1_SECRET=
SAFEPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Safepay recurring plans — one plan token ("plan_…") per plan and cycle
#
# Create these under Subscriptions > Plans in the Safepay dashboard. The
# amount, currency and interval live on the plan, which is what makes the
# price untouchable from here: a checkout names a plan token, and Safepay
# charges whatever that plan says. Neither the browser nor this server can
# alter it.
#
# Set each plan's interval to match the cycle it is mapped to (MONTH / YEAR).
# A pair left blank is a plan this deployment does not sell — asking to check
# out on it returns 503 rather than a checkout URL naming a plan that does
# not exist.
# ---------------------------------------------------------------------------
SAFEPAY_PLAN_PRO_MONTHLY=
SAFEPAY_PLAN_PRO_YEARLY=
SAFEPAY_PLAN_BUSINESS_MONTHLY=
SAFEPAY_PLAN_BUSINESS_YEARLY=

# Register this endpoint under Developers > Endpoints:
#
#   https://<your-api-host>/api/v1/billing/webhook
#
# subscribed to: subscription.created, subscription.payment.succeeded,
#                subscription.payment.failed, subscription.canceled,
#                subscription.ended, subscription.paused, subscription.resumed
#
# The shopper must pay with the email address on their QuiLLora account: a
# Safepay subscription event carries no reference back to the checkout that
# opened it, so the account's own pending upgrade plus its verified email is
# what ties the payment to the right user.
